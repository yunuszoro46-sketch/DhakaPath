# Copy to .env (never commit .env). Everything is optional: without AI keys the rule parser answers.
PORT=3000
# Free-tier AI: Gemini first, Groq as the backup. Check model names in AI Studio / Groq on the day.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_MS=4000
# Admin screen password. If empty, a one-time password is printed at start-up.
ADMIN_PASSWORD=
# Saved state (state.json snapshot). Use "off" for memory only.
STATE_FILE=
# Simulated clock speed (1 = real time, 0 = frozen until +15/+30/+90 is pressed)
CLOCK_SPEED=1
# LOG=off to silence request logs. USE_EXPRESS=1 to run on real Express after npm install.
LOG=
USE_EXPRESS=
