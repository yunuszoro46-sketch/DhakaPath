{
  "name": "dhakapath",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DhakaPath: grounded route, fare and street-alert assistant for Dhaka commuters (INIF 2026; seed data, not official).",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "reset": "node tools/reset.js",
    "demo-cache": "node tools/make_demo_cache.js",
    "preview": "python3 tools/bundle.py dist/dhakapath-preview.html",
    "fuzz": "node tools/browser-checks/fuzz.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "express": "^4.21.2"
  },
  "license": "MIT"
}
